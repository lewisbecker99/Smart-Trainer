# --- App ---
# Public URL of your deployment (no trailing slash). Used for OAuth redirects and webhooks.
APP_URL=https://your-app.vercel.app
# Password to log into the app (single-user app).
APP_PASSWORD=change-me
# Random 32+ char string used to sign session cookies and OAuth state.
SESSION_SECRET=generate-a-long-random-string
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when set.
CRON_SECRET=another-long-random-string
# Your IANA time zone; used to decide what "today" is.
TZ_NAME=Europe/Berlin

# --- Database (Postgres, e.g. Neon / Supabase / Vercel Postgres) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Strava (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it when verifying the webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --- WHOOP (https://developer-dashboard.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# --- Web Push (generate with: npm run vapid) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional: Telegram as a second daily channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
